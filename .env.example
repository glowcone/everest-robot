ABSURD_DATABASE_URL=postgresql://robot:robot@localhost:5432/robot
ROBOT_QUEUE=robot

# MakerMod robot hardware (used when the workflow is started with robot=makermod)
ROBOT_OVERHEAD_CAMERA_INDEX=0
ROBOT_WRIST_CAMERA_INDEX=1
ROBOT_HOMOGRAPHY_PATH=config/homography.json
ROBOT_TABLE_Z_M=0.02
ROBOT_GRASP_CLEARANCE_M=0.08
# HSV detection bounds (H 0-179, S/V 0-255) and minimum blob area in pixels
ROBOT_HSV_LOWER=35,80,80
ROBOT_HSV_UPPER=85,255,255
ROBOT_MIN_CONTOUR_AREA=400
# Wrist-camera gripper ROI as fractions: x, y, width, height
ROBOT_GRIPPER_ROI=0.3,0.4,0.4,0.4
ROBOT_GRIPPER_MASK_MIN_PIXELS=200
# Arm geometry in meters: shoulder height, upper arm, forearm, gripper length
ROBOT_ARM_BASE_HEIGHT_M=0.10
ROBOT_ARM_UPPER_LINK_M=0.12
ROBOT_ARM_FOREARM_LINK_M=0.12
ROBOT_ARM_GRIPPER_LENGTH_M=0.09
# maker-arm SDK connection: slcan (macOS serial CANable) or socketcan (Linux)
ROBOT_ARM_BACKEND=slcan
ROBOT_ARM_PORT=/dev/cu.usbmodem-FOLLOWER
#ROBOT_ARM_CHANNEL=can0
# Optional override of the SDK's shipped maker_arm_v1 profile
#ROBOT_ARM_PROFILE=
# IK joint (base_yaw, shoulder, elbow, wrist) -> motor mapping: SDK target = zero + sign*angle
# Motors are 0-indexed: 0=base ... 5=wrist roll, 6=gripper. Calibrate at bring-up.
ROBOT_IK_MOTOR_INDICES=0,1,2,4
ROBOT_IK_SIGNS=1,1,1,1
ROBOT_IK_ZEROS=0,0,5.9,2.1
# Neutral pose for all 7 joints (holds the unmapped motors); must be inside profile limits
ROBOT_ARM_NEUTRAL_JOINTS=0,0,5.9,0,2.1,3.6,-1.0
# Gripper joint-7 position targets (rad); close stalls compliantly on the carabiner
ROBOT_GRIPPER_OPEN_RAD=-2.0
ROBOT_GRIPPER_CLOSED_RAD=-0.1
ROBOT_ARM_SETTLE_TOL_RAD=0.05
ROBOT_ARM_SETTLE_TIMEOUT_S=10
ROBOT_GRIPPER_DWELL_S=1.5


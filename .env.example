ABSURD_DATABASE_URL=postgresql://robot:robot@localhost:5432/robot
ROBOT_QUEUE=robot


# Identity of the arm this deployment drives. Must match config/maker_arm_v1.yaml.
EVEREST_ROBOT_ID=maker-arm-02
EVEREST_CALIBRATION_ID=maker-arm-02-2026-08-20
# CAN interface: socketcan interface name, or a serial port with EVEREST_CAN_BACKEND=slcan.
EVEREST_CAN_PORT=can0
EVEREST_CAN_BACKEND=socketcan
# Required for FK/IK only. It must be the physically validated six-axis Maker Arm model.
# EVEREST_ARM_URDF=/absolute/path/to/maker_arm_v1.urdf
# EVEREST_ARM_BASE_LINK=base_link
# EVEREST_ARM_TOOL_LINK=gripper_frame_link
# Hugging Face credentials for a private dataset are read from HF_TOKEN by huggingface_hub.
# HF_TOKEN=

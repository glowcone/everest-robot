ABSURD_DATABASE_URL=postgresql://robot:robot@localhost:5432/robot
ROBOT_QUEUE=robot
# Where that Postgres runs: docker (compose.yaml) or native (a PostgreSQL the host
# already has). Auto-detected when unset; only the `database` recipes read it.
# EVEREST_DB_BACKEND=native


# Identity of the arm this deployment drives. Must match config/maker_arm_v1.yaml.
EVEREST_ROBOT_ID=maker-arm-02
EVEREST_CALIBRATION_ID=maker-arm-02-2026-08-20
# CAN interface: socketcan interface name, or a serial port with EVEREST_CAN_BACKEND=slcan.
EVEREST_CAN_PORT=can0
EVEREST_CAN_BACKEND=socketcan
# Arm driver: maker-arm (default, private protocol) or mit for motors provisioned in MIT
# mode, which is what maker-arm-02 runs. WARNING: mit lacks motor/host watchdogs and
# fault-hold; calibration monitor only (see docs/adr/0002-mit-protocol-motor-operation.md).
# EVEREST_ARM_DRIVER=mit
# Star Arm 102 UART leader used by powered `just monitor` calibration teleoperation.
EVEREST_STAR_PORT=/dev/ttyUSB0
# Policy observation cameras. The names and the resolution must match what the checkpoint
# was trained on -- `just policy-check <checkpoint>` prints both and compares them to this.
# Distinct from the pixel map's fixed camera (EVEREST_PIXEL_MAP), which is part of that
# calibration; if a device appears in both, SEARCH_CV and the policy would open it twice.
# EVEREST_CAMERAS='[{"name":"wrist","kind":"opencv","index_or_path":"2","width":640,"height":480,"fps":30},{"name":"front","kind":"opencv","index_or_path":"0","width":640,"height":480,"fps":30}]'
# Which configured camera the attachment detector looks through, and its colour order.
# EVEREST_WRIST_CAMERA=wrist
# EVEREST_WRIST_CAMERA_COLOR=rgb
# Hugging Face credentials for a private dataset are read from HF_TOKEN by huggingface_hub.
# HF_TOKEN=
